<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerSong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/DayNight">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/left_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="24dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/right_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="24dp" />

            <Button
                android:id="@+id/ic_vector_buck"
                style="@style/BackButtonStyle"
                android:layout_width="@dimen/layout_width_48"
                android:layout_height="@dimen/height_48"
                android:layout_marginStart="@dimen/marginStart_4"
                android:layout_marginTop="@dimen/marginTop_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:pressedTranslationZ="2dp" />

            <ImageView
                android:id="@+id/imageViewPlayerPlaceholder"
                style="@style/ImagePlaceholder"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/ic_vector_buck" />

            <TextView
                android:id="@+id/trackNameTv"
                style="@style/TextTrackName"
                android:text="@string/The_name_of_the_song"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/imageViewPlayerPlaceholder" />

            <TextView
                android:id="@+id/artistNameTv"
                style="@style/TextArtistName"
                android:text="@string/executor"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/trackNameTv" />

            <ImageButton
                android:id="@+id/buttonQueue"
                style="@style/ImageButtonStyle.Queue"
                app:layout_constraintEnd_toStartOf="@id/button_pause"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/artistNameTv" />

            <ToggleButton
                android:id="@+id/button_pause"
                style="@style/ImageButtonStyle.Play"
                app:layout_constraintEnd_toStartOf="@id/buttonBorder"
                app:layout_constraintStart_toEndOf="@id/buttonQueue"
                app:layout_constraintTop_toBottomOf="@id/artistNameTv"
                android:background="@drawable/play_pause_selector"
                android:textOff=""
                android:textOn="" />

            <ImageButton
                android:id="@+id/buttonBorder"
                style="@style/ImageButtonStyle.Favorite"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/button_pause"
                app:layout_constraintTop_toBottomOf="@id/artistNameTv" />

            <TextView
                android:id="@+id/trackDuration"
                style="@style/TextTrackDuration"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/button_pause"
                tools:text="00:00" />

            <TextView
                android:id="@+id/currentTimeText"
                style="@style/TextTrackDuration"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="00:00"
                app:layout_constraintEnd_toEndOf="@id/right_guideline"
                app:layout_constraintStart_toStartOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/button_pause" />

            <TextView
                android:id="@+id/textDuration"
                style="@style/TextLabel"
                android:layout_marginTop="30dp"
                android:text="@string/duration"
                app:layout_constraintEnd_toStartOf="@id/trackDurationText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/trackDuration" />

            <TextView
                android:id="@+id/trackDurationText"
                style="@style/TextValue"
                android:layout_marginTop="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textDuration"
                app:layout_constraintTop_toBottomOf="@id/trackDuration"
                tools:text="0:30" />

            <TextView
                android:id="@+id/collectionName"
                style="@style/TextLabel"
                android:text="@string/collectionName"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/collectionNameValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textDuration" />

            <TextView
                android:id="@+id/collectionNameValue"
                style="@style/TextValue"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/collectionName"
                app:layout_constraintTop_toBottomOf="@id/textDuration"
                tools:text="Альбом" />

            <TextView
                android:id="@+id/releaseDate"
                style="@style/TextLabel"
                android:text="@string/Date"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/releaseDateValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/collectionName" />

            <TextView
                android:id="@+id/releaseDateValue"
                style="@style/TextValue"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/releaseDate"
                app:layout_constraintTop_toBottomOf="@id/collectionName"
                tools:text="2026" />

            <TextView
                android:id="@+id/primaryGenreName"
                style="@style/TextLabel"
                android:text="@string/primaryGenreName"
                app:layout_constraintEnd_toStartOf="@id/primaryGenreValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/releaseDate" />

            <TextView
                android:id="@+id/primaryGenreValue"
                style="@style/TextValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/primaryGenreName"
                app:layout_constraintTop_toBottomOf="@id/releaseDate"
                tools:text="Рок" />

            <TextView
                android:id="@+id/country"
                style="@style/TextLabel"
                android:text="@string/country"
                app:layout_constraintEnd_toStartOf="@id/countryValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreName" />

            <TextView
                android:id="@+id/countryValue"
                style="@style/TextValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/country"
                app:layout_constraintTop_toBottomOf="@id/primaryGenreName"
                tools:text="Антарктида" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/bottom_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bottom_sheet_handle" />

        <TextView
            android:id="@+id/tv_bottom_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Добавить в плейлист"
            android:textSize="19sp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="@color/black"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_new_playlist_bottom_sheet"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Новый плейлист"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:fontFamily="@font/ys_display_medium"
            android:background="@drawable/btn_new_playlist" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_playlists_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

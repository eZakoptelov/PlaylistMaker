<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_61"
    android:paddingHorizontal="@dimen/paddingHorizontal_8"
    android:paddingVertical="@dimen/paddingVertical_4">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_playlist_cover"
        android:layout_width="@dimen/layout_width_45"
        android:layout_height="@dimen/layout_height_45"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        app:shapeAppearanceOverlay="@style/RoundedCorner8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_playlist_name"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_height_19"
        android:layout_marginStart="@dimen/marginStart_8"
        android:layout_marginTop="@dimen/paddingTop_6"
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/black"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/iv_playlist_cover"
        app:layout_constraintStart_toEndOf="@id/iv_playlist_cover"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_track_count"
        android:layout_width="0dp"
        android:layout_height="@dimen/layout_height_13"
        android:layout_marginStart="@dimen/marginStart_8"
        android:layout_marginBottom="@dimen/paddingBottom_8"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/grey"
        android:textSize="@dimen/text_size_11"
        app:layout_constraintBottom_toBottomOf="@id/iv_playlist_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/iv_playlist_cover" />

</androidx.constraintlayout.widget.ConstraintLayout>
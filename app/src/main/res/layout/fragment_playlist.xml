<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Шапка плейлиста -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_grey">

        <LinearLayout
            android:id="@+id/llHeaderContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_360"
            android:orientation="vertical"
            android:background="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/ll_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ic_vector_buck"
                    android:layout_width="@dimen/layout_width_48"
                    android:layout_height="@dimen/height_48"
                    android:layout_marginStart="@dimen/marginStart_4"
                    android:layout_marginTop="@dimen/marginTop_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/padding_15"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_vector_buck_16" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/flCover"
                android:layout_width="@dimen/layout_width_236"
                android:layout_height="@dimen/layout_height_233"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/marginTop_7">

                <ImageView
                    android:id="@+id/ivPlaylistCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_placeholder" />

            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginStart_16"
            android:layout_marginEnd="@dimen/marginEnd_16"
            android:layout_marginTop="@dimen/marginTop_24"
            android:fontFamily="@font/ys_display_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_24"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llHeaderContent"
            tools:text="Best songs 2021" />

        <TextView
            android:id="@+id/tvPlaylistDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginStart_16"
            android:layout_marginEnd="@dimen/marginEnd_16"
            android:layout_marginTop="@dimen/marginTop_8"
            android:textColor="@color/black"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistName"
            tools:text="2022" />

        <TextView
            android:id="@+id/tvPlaylistMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginStart_16"
            android:layout_marginTop="@dimen/marginTop_8"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistDescription"
            tools:text="300 минут · 98 треков" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="@dimen/layout_width_40"
            android:layout_height="@dimen/layout_height_40"
            android:layout_marginStart="@dimen/marginStart_16"
            android:layout_marginTop="@dimen/marginTop_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/paddingHorizontal_8"
            android:src="@drawable/ic_share"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistMeta" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/layout_width_40"
            android:layout_height="@dimen/layout_height_40"
            android:layout_marginStart="@dimen/marginStart_16"
            android:layout_marginTop="@dimen/marginTop_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/paddingHorizontal_8"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toEndOf="@id/btnShare"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistMeta" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BottomSheet: список треков -->
    <LinearLayout
        android:id="@+id/clBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:visibility="visible"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/bottom_sheet_tracks_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/vHandle"
            android:layout_width="@dimen/layout_width_50"
            android:layout_height="@dimen/bottom_sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/marginTop_8"
            android:background="@color/light_grey" />

        <!-- Список треков -->

        <!-- Пустое состояние -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/marginTop_12"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/paddingBottom_16"
            tools:listitem="@layout/item_track" />

        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="top|center_horizontal"
            android:paddingTop="@dimen/paddingTop_102">

            <TextView
                android:id="@+id/tvEmptyStateTracks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_medium"
                android:text="@string/empty_playlist_tracks"
                android:textColor="@color/playlist_menu_text"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

    </LinearLayout>

    <!-- Затемнение для меню -->
    <View
        android:id="@+id/vMenuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50000000"
        android:visibility="gone" />

    <!-- BottomSheet меню -->
    <LinearLayout
        android:id="@+id/clMenuBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_383"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:visibility="gone"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="@dimen/layout_width_50"
            android:layout_height="@dimen/bottom_sheet_handle_height"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/marginTop_8"
            android:background="@color/light_grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_61"
            android:layout_marginTop="@dimen/marginTop_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMenuCover"
                android:layout_width="@dimen/layout_width_45"
                android:layout_height="@dimen/layout_height_45"
                android:layout_marginStart="@dimen/marginStart_13"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginStart_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMenuPlaylistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    android:textColor="@color/playlist_menu_text"
                    android:textSize="@dimen/text_size_16"
                    tools:text="Best songs 2021" />

                <TextView
                    android:id="@+id/tvMenuTracksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/text_size_11"
                    tools:text="98 треков" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuShare"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_61"
            android:layout_marginTop="@dimen/marginTop_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/paddingHorizontal_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginStart_16"
                android:fontFamily="@font/ys_display_regular"
                android:text="@string/share"
                android:textColor="@color/playlist_menu_text"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuEdit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_61"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/paddingHorizontal_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginStart_16"
                android:fontFamily="@font/ys_display_regular"
                android:text="@string/edit_playlist_information"
                android:textColor="@color/playlist_menu_text"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_61"
            android:layout_marginBottom="@dimen/marginBottom_24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/paddingHorizontal_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginStart_16"
                android:fontFamily="@font/ys_display_regular"
                android:text="@string/delete_playlist"
                android:textColor="@color/playlist_menu_text"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
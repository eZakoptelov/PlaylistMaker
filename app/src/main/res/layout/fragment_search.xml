<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/DayNight">

    <LinearLayout
        android:id="@+id/search_product"
        style="@style/DayNight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_height_56">

            <TextView
                android:id="@+id/button_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/marginStart_16"
                android:layout_marginTop="@dimen/marginTop_10"
                android:text="@string/input_hint"
                android:textSize="@dimen/text_size_22"
                android:fontFamily="@font/ys_display_medium" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_52">

            <EditText
                android:id="@+id/inputEditText"
                style="@style/EditTextSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/layout_height_36"
                android:autofillHints="text"
                android:imeOptions="actionDone"
                android:inputType="text|textVisiblePassword"
                tools:ignore="LabelFor" />

            <ImageButton
                android:id="@+id/imageButtonSearchClear"
                style="@style/ButtonCancelSearch"
                android:layout_width="@dimen/layout_width_40"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cancel"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_search_clear_16" />

        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/ProgressBar.Player"
            android:layout_marginTop="@dimen/marginTop_140"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/historyTitle"
                style="@style/HistoryTitleText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_52"
                android:text="@string/You_were_looking_for" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/clearHistoryButton"
                style="@style/ButtonUpdateConnect"
                android:layout_width="@dimen/layout_width_148"
                android:layout_height="@dimen/layout_height_36"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/marginTop_24"
                android:text="@string/Clear_the_history" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/state_nothing_found"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/paddingTop_102"
            android:visibility="gone">

            <ImageView
                style="@style/ImageNothingWasFound_one"
                android:layout_width="@dimen/empty_state_image_size"
                android:layout_height="@dimen/empty_state_image_size" />

            <TextView
                style="@style/TextViewEmptyState_Two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nothing_was_found" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/state_error_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/marginStart_24"
            android:visibility="gone">

            <ImageView
                style="@style/ImageConnect"
                android:layout_width="@dimen/empty_state_image_size"
                android:layout_height="@dimen/empty_state_image_size"
                android:layout_marginTop="@dimen/paddingTop_102" />

            <TextView
                style="@style/TextViewConnectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_connection" />

            <TextView
                android:id="@+id/button_connection"
                style="@style/ButtonUpdateConnect"
                android:layout_width="@dimen/layout_width_91"
                android:layout_height="@dimen/layout_height_36"
                android:text="@string/update" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>
